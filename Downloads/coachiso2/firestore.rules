rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Roles Helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'safeness.c.a@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isEditor() {
      return isAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor'
      );
    }
    
    function isViewer() {
      return isEditor() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer'
      );
    }

    // ===============================================================
    // Collection Definitions
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isViewer());
      allow write: if isAdmin() || request.auth.token.email == 'safeness.c.a@gmail.com';
    }

    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isViewer());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isEditor());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, delete: if isEditor();
      allow update: if isEditor() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount']));
    }

    match /visits/{visitId} {
      allow read: if isViewer();
      allow write: if isEditor();
    }

    match /tutorials/{tutorialId} {
      allow read: if isViewer();
      allow write: if isEditor();
    }

    match /audit_logs/{logId} {
      allow read: if isViewer();
      allow create: if isAuthenticated();
    }

    match /mail/{mailId} {
      allow read: if isViewer();
      allow create: if isAuthenticated();
    }
    
    match /2fa_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    
    match /image_registry/{imageId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
