{
  "entities": {
    "Consultation": {
      "title": "Consultation",
      "description": "A booking request for a consultation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the person booking" },
        "name": { "type": "string", "description": "Name of the person" },
        "email": { "type": "string", "format": "email", "description": "Email of the person" },
        "company": { "type": "string", "description": "Company name" },
        "date": { "type": "string", "description": "ISO date string of the requested consultation" },
        "topic": { "type": "string", "description": "Topic of the consultation" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"], "description": "Status of the booking" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the booking was created" }
      },
      "required": ["uid", "name", "email", "date", "topic", "status", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "A consultancy or training course managed by Robert Terán",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Course Title" },
        "description": { "type": "string", "description": "Detailed description" },
        "duration": { "type": "number", "description": "Duration in hours" },
        "level": { "type": "string", "enum": ["Básico", "Intermedio", "Avanzado"] },
        "price": { "type": "number", "description": "Price in USD" },
        "imageUrl": { "type": "string", "description": "Banner or illustration URL" },
        "status": { "type": "string", "enum": ["Activo", "Inactivo"] },
        "materials": { "type": "array", "description": "Assigned resources/book IDs" }
      },
      "required": ["title", "description", "duration", "level", "price", "imageUrl", "status", "materials"]
    },
    "Book": {
      "title": "Book",
      "description": "A book, guide, or PDF resource for client downloading",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string", "description": "ISO 9001, ISO 27001, Coaching, etc." },
        "year": { "type": "number" },
        "coverUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "downloadsCount": { "type": "number" }
      },
      "required": ["title", "author", "category", "year", "coverUrl", "downloadsCount"]
    },
    "Visit": {
      "title": "Visit",
      "description": "An onsite presencial client visit scheduled",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "company": { "type": "string" },
        "date": { "type": "string", "description": "Date string" },
        "time": { "type": "string", "description": "Time string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "company", "date", "time", "status", "createdAt"]
    },
    "Tutorial": {
      "title": "Tutorial",
      "description": "An online tutoring session scheduled",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "email": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "platform": { "type": "string", "enum": ["Zoom", "Meet", "Teams"] },
        "link": { "type": "string", "description": "Meeting invitation link" },
        "topic": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "sendInvitation": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "email", "date", "time", "duration", "platform", "topic", "status", "sendInvitation", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account role details",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
        "name": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "name"]
    }
  },
  "firestore": {
    "/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/Consultation" },
      "description": "Stores user consultation bookings."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Stores training courses."
    },
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Stores PDF resources and books."
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "#/entities/Visit" },
      "description": "Stores presencial onsite scheduling."
    },
    "/tutorials/{tutorialId}": {
      "schema": { "$ref": "#/entities/Tutorial" },
      "description": "Stores online virtual tutoring sessions."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores workspace team profiles with roles."
    }
  }
}
