rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function existsUser() { return signedIn() && exists(userPath()); }
    function role() { return existsUser() ? get(userPath()).data.get('role', 'pending') : 'pending'; }
    function status() { return existsUser() ? get(userPath()).data.get('status', 'pending') : 'pending'; }
    function active() { return signedIn() && status() == 'active'; }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'safeness.c.a@gmail.com';
    }
    function isAdmin() { return isSuperAdmin() || (active() && role() == 'admin'); }
    function isEditor() {
      return isAdmin() || (active() && role() in ['editor', 'supervisor']);
    }
    function isViewer() {
      return active() && role() in ['superadmin','admin','editor','supervisor','colaborador','tlmk','viewer'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSuperAdmin()
                    || (signedIn() && request.auth.uid == userId
                        && request.resource.data.role == 'pending'
                        && request.resource.data.status == 'pending');
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    match /courses/{id} { allow read: if true; allow write: if isEditor(); }
    match /books/{id} {
      allow read: if true;
      allow create, delete: if isEditor();
      allow update: if isEditor() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount']);
    }
    match /visits/{id} { allow read: if isViewer(); allow write: if isEditor(); }
    match /tutorials/{id} { allow read: if isViewer(); allow write: if isEditor(); }
    match /consultations/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isViewer());
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.uid == request.auth.uid || isEditor());
      allow delete: if isAdmin();
    }
    match /audit_logs/{id} { allow read: if isViewer(); allow create: if signedIn(); }
    match /mail/{id} { allow read: if isViewer(); allow create: if signedIn(); }
    match /2fa_sessions/{id} { allow read, write: if signedIn(); }
    match /image_registry/{id} { allow read: if true; allow write: if isEditor(); }
    match /settings/{id} { allow read: if true; allow write: if isEditor(); }

    match /{document=**} { allow read, write: if false; }
  }
}
