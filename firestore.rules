rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function existsUser() { return signedIn() && exists(userPath()); }
    function role() { return existsUser() ? get(userPath()).data.get('role', 'pending') : 'pending'; }
    function status() { return existsUser() ? get(userPath()).data.get('status', 'pending') : 'pending'; }
    function active() { return signedIn() && status() == 'active'; }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'safeness.c.a@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function invitationPath() {
      return /databases/$(db)/documents/invitations/$(request.auth.token.email);
    }
    function hasActiveInvitation() {
      return signedIn()
        && request.auth.token.email != null
        && exists(invitationPath())
        && get(invitationPath()).data.email == request.auth.token.email
        && get(invitationPath()).data.status == 'active'
        && get(invitationPath()).data.role in ['admin','supervisor','editor','colaborador','tlmk','cliente','viewer'];
    }
    function isAdmin() { return isSuperAdmin() || (active() && role() == 'admin'); }
    function isEditor() {
      return isAdmin() || (active() && role() in ['editor', 'supervisor']);
    }
    function isViewer() {
      return isSuperAdmin() || (active() && role() in ['admin','editor','supervisor','colaborador','tlmk','viewer']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSuperAdmin()
                    || (signedIn() && request.auth.uid == userId
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.role == 'pending'
                        && request.resource.data.status == 'pending')
                    || (hasActiveInvitation() && request.auth.uid == userId
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.role == get(invitationPath()).data.role
                        && request.resource.data.status == 'active');
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Only the verified super administrator can create, change or revoke invitations.
    // Invitees can read only the invitation matching their authenticated email.
    match /invitations/{email} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isSuperAdmin()
        && request.resource.data.email == email
        && request.resource.data.role in ['admin','supervisor','editor','colaborador','tlmk','cliente','viewer']
        && request.resource.data.status == 'active';
      allow delete: if isSuperAdmin();
    }

    match /courses/{id} { allow read: if true; allow write: if isEditor(); }
    match /books/{id} {
      allow read: if true;
      allow create, delete: if isEditor();
      allow update: if isEditor()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount'])
            && request.resource.data.downloadsCount is int
            && resource.data.downloadsCount is int
            && request.resource.data.downloadsCount == resource.data.downloadsCount + 1);
    }
    match /visits/{id} { allow read: if isViewer(); allow write: if isEditor(); }
    match /tutorials/{id} { allow read: if isViewer(); allow write: if isEditor(); }
    match /consultations/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isViewer());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isEditor()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'company', 'date', 'topic']));
      allow delete: if isAdmin();
    }
    match /certificates/{id} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    match /audit_logs/{id} { allow read: if isViewer(); allow create: if isEditor(); }
    match /ai_activity_logs/{id} { allow read: if isViewer(); allow write: if false; }
    // Email queue is written only by trusted server code.
    match /mail/{id} { allow read: if isViewer(); allow write: if false; }
    // No client-side access: a secure server-side MFA flow has not been implemented.
    match /2fa_sessions/{id} { allow read, write: if false; }
    match /image_registry/{id} { allow read: if true; allow write: if isEditor(); }
    match /settings/{id} { allow read: if true; allow write: if isEditor(); }

    match /{document=**} { allow read, write: if false; }
  }
}
